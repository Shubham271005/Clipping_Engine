# Copy to .env and fill in. Never commit .env (it is git-ignored).

DEFAULT_PROFILE=gta6

# --- YouTube (Google Cloud OAuth "Desktop app" client JSON) ---
YT_CLIENT_SECRETS=secrets/client_secret.json

# --- Instagram API with Instagram Login ---
# Token from Meta App Dashboard > Instagram > API setup with Instagram login > Generate token
IG_ACCESS_TOKEN=
# Optional: lets the engine exchange short-lived tokens for 60-day long-lived ones
IG_APP_SECRET=
